# Servidor
NODE_ENV=development
PORT=3001
CORS_ORIGEN=http://localhost:5173
LOG_LEVEL=info

# Base de datos
# Reemplazá TU_CLAVE por la contraseña del usuario postgres.
DATABASE_URL=postgres://postgres:TU_CLAVE@localhost:5432/veterinaria_dev
TEST_DATABASE_URL=postgres://postgres:TU_CLAVE@localhost:5432/veterinaria_test

# Autenticación
# JWT_SECRET tiene que tener 32 caracteres o más.
JWT_SECRET=cambia-esto-por-un-secreto-de-al-menos-32-caracteres
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=cambia-esta-clave
SEED_DEMO_PASSWORD=cambia-esta-clave

# Presentación de fechas
ZONA_HORARIA=America/Argentina/Tucuman
