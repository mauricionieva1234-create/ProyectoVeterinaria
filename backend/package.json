{
  "name": "@veterinaria/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:create": "node scripts/crear-bases.js",
    "db:migrate": "node scripts/migrar.js up dev",
    "db:migrate:test": "node scripts/migrar.js up test",
    "db:rollback": "node scripts/migrar.js down dev",
    "db:rollback:test": "node scripts/migrar.js down test",
    "db:reset": "node scripts/reset.js",
    "seed": "node scripts/seed.js",
    "seed:demo": "node scripts/seed-demo.js",
    "db:backup": "node scripts/backup.js"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "node-pg-migrate": "9.0.0",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.2",
    "vitest": "5.1.0"
  }
}
