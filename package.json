{
  "name": "veterinaria",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test -w backend && npm run test -w frontend",
    "test:backend": "npm run test -w backend",
    "test:frontend": "npm run test -w frontend",
    "db:create": "npm run db:create -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:migrate:test": "npm run db:migrate:test -w backend",
    "db:rollback": "npm run db:rollback -w backend",
    "db:reset": "npm run db:reset -w backend",
    "seed": "npm run seed -w backend",
    "seed:demo": "npm run seed:demo -w backend",
    "db:backup": "npm run db:backup -w backend",
    "db:backup:verificar": "npm run db:backup:verificar -w backend"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "concurrently": "10.0.7",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "prettier": "3.9.10"
  }
}
